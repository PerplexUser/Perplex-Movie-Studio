# Cross compilation from Linux. Set PMS_TOOLCHAIN_ROOT, QT_HOST_PATH and Qt6_DIR.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PMS_TOOLCHAIN_ROOT "$ENV{PMS_TOOLCHAIN_ROOT}" CACHE PATH "MinGW root (contains usr)")
set(CMAKE_C_COMPILER "${PMS_TOOLCHAIN_ROOT}/usr/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "${PMS_TOOLCHAIN_ROOT}/usr/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "${PMS_TOOLCHAIN_ROOT}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${PMS_TOOLCHAIN_ROOT}/usr/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
